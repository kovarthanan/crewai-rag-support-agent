# Copy this file to .env and fill in your keys:  cp .env.example .env

# --- Required ---
OPENAI_API_KEY=sk-your-openai-key
SERPER_API_KEY=your-serper-key

# --- Optional (defaults shown) ---
OPENAI_MODEL_NAME=gpt-4o-mini
MIN_SIMILARITY_SCORE=0.40     # below this, Agent 1 hands over to web search
TOP_K=4                       # chunks returned per vector search
LOG_FILE=logs/support_log.txt
CREW_VERBOSE=false            # true = show agent reasoning in the terminal
